# Adapted for React + TypeScript + Vite, npm, Vitest, and Playwright.
# Sources:
# https://github.com/github/gitignore/blob/main/Node.gitignore
# https://github.com/vitejs/vite/blob/main/packages/create-vite/template-react-ts/_gitignore
# Keep package-lock.json, source assets, test fixtures, and CI workflows tracked.

# Dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/

# Build output and Vite caches
dist/
dist-ssr/
.vite/
.vite-temp/
vite.config.*.timestamp-*
*.tsbuildinfo

# Logs and runtime diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
*.pid
*.pid.lock
.node_repl_history

# Tests, coverage, and browser artifacts
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/

# Tool caches and local package archives
.cache/
.eslintcache
.stylelintcache
*.tgz

# Local environment configuration; sanitized examples stay tracked
.env
.env.*
!.env.example
*.local

# Editor files; allow intentional shared VS Code settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Local scratch data and private card-photo benchmarks
/tmp/
/temp/
/benchmarks/private/
